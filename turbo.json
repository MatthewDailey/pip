    "@shady-pip/pip-rive#build": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/rivc#build"
      ],
      "inputs": [
        "build.sh",
        "pip/*.json",
        "pip/*.svg",
        "showreel/*.json",
        "showreel/gen/**",
        "showreel/fonts/**",
        "sets/*.svg",
        "sets/*.rivc.json",
        "stories/**",
        "roam/*.json",
        "roam/*.svg"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "@shady-pip/pip-rive#rive:greet": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/pip-rive#rive:roam": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/pip-rive#rive:rig": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/rivc#build"
      ],
      "cache": false
