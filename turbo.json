    "@shady-pip/pip-call#build": {
      "dependsOn": [
        "//#setup"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "sim": {
      "dependsOn": [
        "//#setup"
      ],
      "cache": false
    },
    "@shady-pip/jev-playground#build": {
      "dependsOn": [
        "//#setup"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "typecheck": {
      "dependsOn": [
