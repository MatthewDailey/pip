    "goldens": {
      "inputs": [
        "*.mjs",
        "*.json",
        "index.html",
        "preview.js",
        "vendor/**",
        "fixtures/**",
        "goldens/*.png"
      ],
      "outputs": [],
      "dependsOn": [
        "//#setup"
      ]
    },
    "golden:update": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "playwright:install": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "art:fx": {
      "cache": false,
      "dependsOn": [
