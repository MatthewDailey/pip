      ]
    },
    "call:fake": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:app": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:live": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:irs": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:bank": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:grandson": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:pharmacy": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "call:list": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "voice:greeting": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "pip:sampler": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "pip:peeks": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "pip:showreel": {
      "cache": false,
      "dependsOn": [
        "//#setup"
