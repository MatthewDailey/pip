      ]
    },
    "art:sets-6090": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "art:icon": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "art:sets-modern": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "//#demo": {
      "cache": false,
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ]
    },
    "//#demo:reset": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "//#setup": {
      "cache": false,
      "outputs": [],
      "outputLogs": "errors-only"
    },
    "dev": {
      "dependsOn": [
        "//#setup"
      ],
      "persistent": true,
      "cache": false
    },
    "//#dev": {
      "dependsOn": [
        "//#setup"
      ],
      "persistent": true,
      "cache": false,
      "interactive": true
