{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "tui",
  "globalPassThroughEnv": [
    "JAVA_HOME",
    "ANDROID_HOME",
    "ANDROID_SDK_ROOT",
    "ANDROID_SERIAL",
    "AVD_NAME",
    "EMULATOR_FOREGROUND",
    "LOGCAT_TAGS",
    "GRADLE_USER_HOME",
    "RIVC_GRADLE",
    "RIVC_CMD",
    "PREVIEW_SRC",
    "PORT",
    "BACKDROP",
    "OPENAI_API_KEY",
    "OPENAI_SECRET",
    "OPENAI_SECRET_PROJECT",
    "CLOUDSDK_CONFIG",
    "ADB",
    "SYNC_NUDGE",
    "SHOW_TIMEOUT",
    "SHOW_ARGS",
    "SHOW_ACTION",
    "OUT_NAME",
    "SOUNDTRACK_FROM",
    "SOUNDTRACK_TO",
    "TMPDIR",
    "JEV_API_KEY",
    "JEV_MODEL",
    "JEV_API_BASE_URL",
    "ANTHROPIC_API_KEY",
    "LLM_PROVIDER",
    "LLM_MODEL",
    "OPENAI_MODEL",
    "ANTHROPIC_MODEL",
    "TWILIO_ACCOUNT_SID",
    "TWILIO_AUTH_TOKEN",
    "PIP_LINE_NUMBER",
    "MOM_NUMBER",
    "ROBO_CALLER_NUMBER",
    "PUBLIC_BASE_URL",
    "VERCEL_AUTOMATION_BYPASS_SECRET",
    "KV_REST_API_URL",
    "KV_REST_API_TOKEN",
    "PIP4_URL",
    "PIP4_APPROACH",
    "PIP4_BYPASS_SECRET",
    "PIP_TWILIO",
    "PIP_RECORD",
    "PIP_SKIP_SIGNATURE",
    "TWILIO_PIP_LINE",
    "TWILIO_ROBO_CALLER",
    "TWILIO_API_KEY",
    "TWILIO_API_SECRET",
    "TWILIO_API_KEY_SID",
    "TWILIO_API_KEY_SECRET",
    "TWILIO_TWIML_APP_SID",
    "TWILIO_PUSH_CREDENTIAL_SID",
    "PIP_APP_SECRET",
    "MOM_CLIENT_IDENTITY",
    "PIP_VOICE",
    "OPENAI_PROJECT_ID",
    "OPENAI_WEBHOOK_SECRET",
    "PIP_REALTIME_MODEL",
    "PIP_REALTIME_VOICE",
    "DEBUG_TOKEN",
    "PIP_STT_ENGINE",
    "PIP_STT_MODEL",
    "PIP_CALL_URL",
    "PIP_USER",
    "SCENARIOS_AUTO",
    "SCENARIOS_PORT",
    "PIP_MUTE_PATH",
    "PIP_SPEAK"
  ],
  "globalDependencies": [
    "scripts/env.sh"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "//#setup",
        "^build"
      ],
      "outputs": []
    },
    "test": {
      "dependsOn": [
        "//#setup",
        "build"
      ],
      "outputs": []
    },
    "lint": {
      "outputs": [],
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/rivc#build": {
      "inputs": [
        "src/main/**",
        "schema/**",
        "*.gradle.kts",
        "gradle/**",
        "rivc"
      ],
      "outputs": [
        "build/install/**"
      ],
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/rivc#test": {
      "dependsOn": [
        "//#setup",
        "build"
      ],
      "inputs": [
        "src/**",
        "schema/**",
        "examples/**",
        "*.gradle.kts",
        "gradle/**"
      ],
      "outputs": [
        "build/test-results/**"
      ]
    },
    "@shady-pip/rivc#rivc:test": {
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/pip-app#build": {
      "inputs": [
        "app/src/main/**",
        "app/build.gradle.kts",
        "*.gradle.kts",
        "gradle.properties",
        "gradle/**"
      ],
      "outputs": [
        "app/build/outputs/apk/**"
      ],
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ]
    },
    "@shady-pip/pip-app#test": {
      "dependsOn": [
        "//#setup",
        "build",
        "@shady-pip/pip-rive#build"
      ],
      "inputs": [
        "app/src/main/**",
        "app/src/test/**",
        "app/build.gradle.kts",
        "*.gradle.kts",
        "gradle.properties",
        "gradle/**"
      ],
      "outputs": [
        "app/build/test-results/**"
      ]
    },
    "@shady-pip/pip-app#lint": {
      "inputs": [
        "app/src/**",
        "app/build.gradle.kts",
        "*.gradle.kts",
        "gradle.properties",
        "gradle/**"
      ],
      "outputs": [
        "app/build/reports/lint-results-debug.*"
      ],
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ]
    },
    "@shady-pip/pip-app#pip:push": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/pip-app#pip:roam": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/pip-app#pip:greet": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/pip-app#pip:greet-record": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/pip-app#pip:roam-stop": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/pip-app#pip:story": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "cache": false
    },
    "@shady-pip/showreel-to-rivc#build:wip": {
      "inputs": [
        "src/main/**",
        "*.gradle.kts",
        "../rivc/src/main/**"
      ],
      "outputs": [
        "build/install/**"
      ],
      "dependsOn": [
        "//#setup"
      ]
    },
    "@shady-pip/showreel-to-rivc#test:wip": {
      "dependsOn": [
        "//#setup",
        "build:wip"
      ],
      "outputs": []
    },
    "emulator": {
      "persistent": true,
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "logcat": {
      "persistent": true,
      "cache": false,
      "dependsOn": [
        "//#setup"
      ]
    },
    "preview": {
