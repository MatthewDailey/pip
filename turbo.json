      "cache": false,
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ]
    },
    "@shady-pip/pip-app#app:setup": {
      "cache": false,
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ]
    },
    "@shady-pip/pip-app#droid": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-rive#build"
      ],
      "persistent": true,
      "cache": false
    },
    "@shady-pip/pip-fixtures#build": {
      "dependsOn": [
        "//#setup"
      ],
      "inputs": [
        "app/src/main/**",
        "app/build.gradle.kts",
        "*.gradle.kts",
        "gradle.properties",
        "gradle/**"
      ],
      "outputs": [
        "app/build/outputs/apk/**"
      ]
    },
    "@shady-pip/pip-scenarios#scenarios": {
      "dependsOn": [
        "//#setup",
        "@shady-pip/pip-fixtures#build"
      ],
