{
  "format": 1,
  "assets": [{ "name": "Inter-Bold", "font": "fonts/Inter-Bold.ttf" }],
  "artboards": [
    {
      "artboard": { "name": "Main", "width": 1080, "height": 2424, "clip": true },
      "art": { "svg": "stage.svg" },
      "viewModel": {
        "name": "Stage",
        "properties": [
          { "name": "holeX", "type": "number", "default": 780 },
          { "name": "holeY", "type": "number", "default": 1560 }
        ]
      },
      "clips": [
        {
          "name": "timeline", "frames": 360, "loop": "loop",
          "tracks": [
            { "target": "pipA/mood", "property": "nestedValue", "keys": [
              { "frame": 0, "value": 0, "ease": "hold" }, { "frame": 60, "value": 1, "ease": "hold" },
              { "frame": 120, "value": 2, "ease": "hold" }, { "frame": 180, "value": 3, "ease": "hold" },
              { "frame": 240, "value": 0, "ease": "hold" }
            ] },
            { "target": "pipB/mood", "property": "nestedValue", "keys": [
              { "frame": 0, "value": 2, "ease": "hold" }, { "frame": 90, "value": 0, "ease": "hold" },
              { "frame": 180, "value": 1, "ease": "hold" }, { "frame": 270, "value": 3, "ease": "hold" }
            ] },
            { "target": "pipB", "property": "x", "keys": [
              { "frame": 0, "value": 560, "ease": "easeInOut" }, { "frame": 180, "value": 260, "ease": "easeInOut" },
              { "frame": 360, "value": 560 }
            ] },
            { "target": "note/wobble", "property": "time", "keys": [
              { "frame": 0, "value": 0 }, { "frame": 120, "value": 1, "ease": "hold" },
              { "frame": 180, "value": 0 }, { "frame": 300, "value": 1 }
            ] },
            { "target": "banner", "property": "opacity", "keys": [
              { "frame": 0, "value": 0 }, { "frame": 90, "value": 0 }, { "frame": 110, "value": 1 }
            ] },
            { "target": "bubble/fill", "property": "colorValue", "keys": [
              { "frame": 0, "color": "#1B2333", "ease": "hold" }, { "frame": 180, "color": "#2F6FD0", "ease": "hold" }
            ] }
          ]
        }
      ],
      "texts": [
        {
          "id": "bubble", "font": "Inter-Bold", "size": 52, "color": "#1B2333",
          "text": "Hi, I'm Pip! Let's check that message together before you tap anything.",
          "x": 180, "y": 330, "width": 720, "height": 300, "verticalAlign": "middle", "lineHeight": 62,
          "changes": [{ "clip": "timeline", "frame": 180, "text": "Good call. Now read the banner below." }]
        },
        {
          "id": "banner", "font": "Inter-Bold", "size": 110, "color": "#FFFFFF",
          "text": "Never share your code",
          "x": 40, "y": 1980, "width": 1000, "height": 360, "align": "center", "verticalAlign": "middle"
        }
      ],
      "instances": [
        {
          "id": "pipA", "artboard": "Pip", "x": 40, "y": 760, "scale": 0.8,
          "fire": [{ "input": "blink", "clip": "timeline", "frames": [30, 210] }]
        },
        { "id": "heart", "artboard": "Heart", "x": 80, "y": 1520, "scale": 1.2 },
        { "id": "note", "artboard": "Note", "x": 820, "y": 760, "remaps": [{ "clip": "wobble" }] },
        { "id": "pipB", "artboard": "Pip", "x": 560, "y": 1300, "scale": 0.8, "inputs": { "mood": 2 }, "mask": "hole" }
      ],
      "masks": [
        {
          "id": "hole", "x": 780, "y": 1560, "width": 420, "height": 420,
          "bind": { "x": "holeX", "y": "holeY" }, "marker": "#5540C080"
        }
      ],
      "events": [
        { "name": "bubble_in", "clip": "timeline", "frames": [30] },
        { "name": "banner_cue", "clip": "timeline", "frames": [90] },
        { "name": "bubble_out", "clip": "timeline", "frames": [180] }
      ]
    },
    { "source": "../spike/pip.json", "control": "inputs" },
    {
      "artboard": { "name": "Heart", "width": 260, "height": 200 },
      "art": { "svg": "sets/fx-heart.svg" },
      "clips": [
        {
          "name": "beat", "frames": 54, "loop": "loop",
          "tracks": [
            { "target": "heart", "property": "scaleX", "keys": [
              { "frame": 0, "value": 1, "ease": "easeInOut" }, { "frame": 14, "value": 1.12, "ease": "easeInOut" },
              { "frame": 27, "value": 1 }, { "frame": 54, "value": 1 }
            ] },
            { "target": "heart", "property": "scaleY", "keys": [
              { "frame": 0, "value": 1, "ease": "easeInOut" }, { "frame": 14, "value": 1.12, "ease": "easeInOut" },
              { "frame": 27, "value": 1 }, { "frame": 54, "value": 1 }
            ] }
          ]
        }
      ]
    },
    {
      "artboard": { "name": "Note", "width": 200, "height": 220 },
      "art": { "svg": "sets/fx-music-note.svg" },
      "clips": [
        {
          "name": "wobble", "frames": 120, "loop": "loop",
          "tracks": [
            { "target": "note", "property": "rotation", "keys": [
              { "frame": 0, "value": 0, "ease": "easeInOut" }, { "frame": 30, "value": 0.35, "ease": "easeInOut" },
              { "frame": 90, "value": -0.35, "ease": "easeInOut" }, { "frame": 120, "value": 0 }
            ] },
            { "target": "note", "property": "y", "keys": [
              { "frame": 0, "value": 0 }, { "frame": 60, "value": -30 }, { "frame": 120, "value": 0 }
            ] }
          ]
        }
      ]
    }
  ]
}
