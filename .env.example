# Copy to .env (gitignored) and fill in what you need. scripts/env.sh loads .env when present.

# voice:greeting (tools/pip-voice/render_greeting.sh) talks to the OpenAI Realtime ("GPT-Live") API.
# Either set the key directly...
OPENAI_API_KEY=
# ...or leave it empty and read it from GCP Secret Manager with your gcloud login, per run:
#   OPENAI_SECRET          secret name (default OPENAI_API_KEY)
#   OPENAI_SECRET_PROJECT  GCP project that holds it (required for this path; no default)
OPENAI_SECRET=
OPENAI_SECRET_PROJECT=

# Optional overrides
# AVD_NAME=Pip_API_37             # emulator the `emulator` task boots (scripts/emulator.sh)
# ANDROID_HOME=$HOME/Library/Android/sdk
# JAVA_HOME=/opt/homebrew/opt/openjdk@21/libexec/openjdk.jdk/Contents/Home
# PREVIEW_SRC=packages/pip-rive/pip/pip.json   # what `preview` compiles and serves
# PORT=8787                       # previewer port

# jev-playground (apps/jev-playground). Without JEV_API_KEY its UI runs in a clearly labelled mock mode.
# You can also put these in apps/jev-playground/.env.local, which Next.js reads directly.
JEV_API_KEY=
# ANTHROPIC_API_KEY=       # optional LLM baseline (OPENAI_API_KEY above also works)
# LLM_PROVIDER=openai|anthropic
# JEV_MODEL= JEV_API_BASE_URL= OPENAI_MODEL= ANTHROPIC_MODEL= LLM_MODEL=

# pip-call (apps/pip-call, Pip3: the live call service). See apps/pip-call/README.md.
# PIP_TWILIO=fake uses RecordingTwilioOps (no Twilio account; only TWILIO_AUTH_TOKEN is needed then).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PIP_LINE_NUMBER=                    # (or TWILIO_PIP_LINE) the number Mom gives out; voice webhook → $PUBLIC_BASE_URL/twiml/voice
MOM_NUMBER=                         # Mom's real phone; during robo-calls the robo-caller number (it answers as robo-mom)
ROBO_CALLER_NUMBER=                 # (or TWILIO_ROBO_CALLER) places robo-call tests
# Elder Guard app (Voice SDK) calls:
TWILIO_API_KEY_SID=                 # (or TWILIO_API_KEY) signs the app's access tokens
TWILIO_API_KEY_SECRET=              # (or TWILIO_API_SECRET)
TWILIO_TWIML_APP_SID=               # TwiML App whose voice URL is $PUBLIC_BASE_URL/twiml/voice
PIP_APP_SECRET=                     # shared secret the app sends as x-pip-app-secret to /token (the Pip app reads it at build time too)
# PIP_CALL_URL=http://localhost:3200         # pip-call base URL the Pip app calls through (build time; your deployed pip-call URL in production)
# PIP_USER=mom                      # the Pip app's Twilio identity
# MOM_CLIENT_IDENTITY=              # Pip line calls ring this app identity instead of MOM_NUMBER (needs push)
# TWILIO_PUSH_CREDENTIAL_SID=       # FCM push credential, incoming calls to the app only
# PIP_STT_ENGINE=deepgram PIP_STT_MODEL=nova-3   # Twilio Real-Time Transcription engine and model
# Pip's live voice on takeover (apps/pip-call README, "Pip's live voice"); uses OPENAI_API_KEY above, same project:
# PIP_VOICE=live
# OPENAI_PROJECT_ID=proj_...
# OPENAI_WEBHOOK_SECRET=whsec_...   # webhook realtime.call.incoming -> $PUBLIC_BASE_URL/openai/realtime
# DEBUG_TOKEN=                      # opens pip-call's /debug/calls pages: ?token=... (the scripts send TWILIO_AUTH_TOKEN instead)
PUBLIC_BASE_URL=                    # where Twilio reaches pip-call: ngrok locally; on Vercel derived if unset
# VERCEL_AUTOMATION_BYPASS_SECRET=  # lets Twilio through Vercel preview protection
# KV_REST_API_URL= KV_REST_API_TOKEN=   # Upstash Redis (set by Vercel when the store is attached; memory if unset)
# PIP4_URL=http://localhost:3100    # Pip4 (jev-playground) base URL (use the port the playground is actually on)
# PIP4_APPROACH=jev                 # or keyword, for the deterministic plumbing check
# PIP4_BYPASS_SECRET=               # protection-bypass secret when Pip4 is a protected Vercel deployment
# PIP_TWILIO=fake  PIP_RECORD=1  PIP_SKIP_SIGNATURE=1
