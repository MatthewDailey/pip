{
  "name": "@shady-pip/pip-app",
  "private": true,
  "description": "The Pip Android app: scam detection, and Pip, the mascot it draws over every app",
  "scripts": {
    "build": ". ../../scripts/env.sh && ./gradlew assembleDebug",
    "test": ". ../../scripts/env.sh && ./gradlew testDebugUnitTest",
    "lint": ". ../../scripts/env.sh && ./gradlew lintDebug",
    "app:install": "bash scripts/setup.sh --no-open",
    "app:setup": "bash scripts/setup.sh",
    "emulator": "bash ../../scripts/emulator.sh",
    "logcat": "bash ../../scripts/logcat.sh",
    "sms:scam": ". ../../scripts/env.sh && bash scripts/simulate.sh scam-sms",
    "sms:hello": ". ../../scripts/env.sh && bash scripts/simulate.sh sms",
    "call:fake": ". ../../scripts/env.sh && bash scripts/simulate.sh call",
    "call:transcript": ". ../../scripts/env.sh && bash scripts/simulate.sh transcript",
    "call:gift-card": ". ../../scripts/env.sh && bash scripts/simulate.sh gift-card",
    "pip:sampler": "bash scripts/pip.sh show sampler",
    "pip:peeks": "bash scripts/pip.sh show peeks",
    "pip:showreel": "bash scripts/pip.sh show",
    "pip:mood": "bash scripts/pip.sh mood",
    "pip:blink": "bash scripts/pip.sh fire blink",
    "pip:bundled": "bash scripts/pip.sh bundled",
    "pip:push": "bash scripts/pip.sh push ../../packages/pip-rive/dist/pip/pip.riv",
    "dev": "bash ../../scripts/emulator.sh && bash ../../scripts/logcat.sh",
    "pip:hodor": "bash scripts/pip.sh rive hodor",
    "pip:showreel-rive": "bash scripts/pip.sh rive showreel",
    "droid": "bash ../../scripts/emulator.sh && bash ../../scripts/logcat.sh",
    "pip:story": "bash scripts/pip.sh story",
    "pip:roam": "bash scripts/pip.sh roam",
    "pip:roam-stop": "bash scripts/pip.sh roam-stop",
    "pip:exploratory": "bash scripts/pip.sh exploratory",
    "pip:detect-scam-call": "bash scripts/pip.sh detect-scam-call",
    "pip:act-unmute": "bash scripts/pip.sh act-unmute",
    "pip:mute-rule": "bash scripts/pip.sh mute-rule",
    "pip:talk": ". ../../scripts/env.sh && adb shell am start -n dev.playground.pip/.TalkToPipActivity",
    "pip:greet": "bash scripts/pip.sh greet",
    "pip:voice": "bash scripts/pip.sh voice",
    "pip:greet-record": ". ../../scripts/env.sh && adb push ../../packages/pip-rive/dist/showreel/hello-install.riv /sdcard/Download/hello-install.riv >/dev/null && SHOW_ACTION=dev.playground.pip.GREET SHOW_ARGS=\"--es greet reset\" OUT_NAME=first-run/hello-install SHOW_TIMEOUT=70 bash ../../tools/pip-show/record.sh",
    "call:app": ". ../../scripts/env.sh && pnpm --filter @shady-pip/pip-call appcall",
    "call:live": ". ../../scripts/env.sh && bash scripts/live-call.sh"
  }
}
